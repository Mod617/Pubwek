venv/
__pycache__/
*.pyc
*.pyo
.env
*.egg-info/
.pytest_cache/

# La base de donnees ne doit jamais revenir dans le depot : elle contient
# les comptes et les empreintes de mots de passe. Retiree par le commit 7f0f02e,
# mais recreee des qu'on lance l'application ou les tests en local.
instance/
*.db

# Environnement virtuel de test local (Python 3.14)
.venv-test/
.venv-verify/

# Outillage Tailwind : seul static/css/pubwek.css (le CSS compile) est versionne,
# pour que Railway n'ait aucune etape de build Node a executer.
node_modules/
package-lock.json

# Configuration locale du serveur d'apercu (chemins absolus propres a la machine)
.claude/launch.json
