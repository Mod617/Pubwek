# =============================================================================
# Modèle de configuration PubWek — copier en .env et remplir.
# Le fichier .env ne doit JAMAIS être versionné ni envoyé par mail/zip.
# =============================================================================

# --- Environnement -----------------------------------------------------------
# "development" (défaut) ou "production".
# En production : HTTPS forcé, cookies Secure, CSP active, DEBUG impossible.
ENV=development
DEBUG=true

# --- Sécurité ----------------------------------------------------------------
# Obligatoire en production. Générer avec :
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Base de données ---------------------------------------------------------
DATABASE_URL=sqlite:///pubwek.db
# En production, préférer PostgreSQL :
# DATABASE_URL=postgresql://utilisateur:motdepasse@localhost/pubwek

# --- Redis (limitation de débit) ---------------------------------------------
# Optionnel. Sans cette variable, les compteurs de limitation sont gardés en
# mémoire : ils repartent à zéro à chaque redémarrage et chaque worker a les
# siens. À définir dès qu'il y a plus d'un worker gunicorn.
REDIS_URL=

# --- Compte administrateur initial -------------------------------------------
# Utilisés uniquement à la première création du compte.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Envoi d'e-mails : API Resend -------------------------------------------
# Railway bloque le SMTP sortant : l'envoi passe par l'API HTTPS de Resend.
# Sans cette clé, la réinitialisation de mot de passe est désactivée et
# l'interface le dit clairement au lieu de faire semblant.
# L'adresse d'expédition (noreply@pubwek.com) doit correspondre à un domaine
# vérifié dans Resend, sinon les envois sont refusés.
RESEND_API_KEY=

